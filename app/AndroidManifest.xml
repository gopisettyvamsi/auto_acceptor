<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.edvenswa.autoaccept">
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- lets the setup check see whether a driver app is installed -->
    <queries>
        <package android:name="com.rapido.rider"/>
        <package android:name="com.rapido.captain"/>
        <package android:name="com.ubercab.driver"/>
        <package android:name="com.olacabs.oladriver"/>
    </queries>
    <application android:label="Vamsify" android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".AcceptService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config"/>
        </service>
        <receiver android:name=".SummaryReceiver" android:exported="false"/>
        <activity android:name=".SampleActivity" android:exported="false"/>
    </application>
</manifest>
